# Krishi Mitra Environment Configuration

# Groq powers web chat text generation; Sarvam powers speech recognition and synthesis.
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Gemini remains available for the legacy NLU/CLI tools.
NLU_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Optional local provider for legacy NLU/CLI tools.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
