# Krishi Mitra Environment Configuration

# Application Environment (development / production)
APP_ENV=development

# Database Configuration (SQLAlchemy 2.0 / Alembic)
# Defaults to SQLite for local development; set postgresql+psycopg2://... for PostgreSQL in production
DATABASE_URL=sqlite:///./krishi_mitra.db

# Authentication & Security Configuration
# CRITICAL: In production mode (APP_ENV=production), server will fail startup if JWT_SECRET is not set!
JWT_SECRET=generate_a_random_32_byte_secret_key_here
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# SMS Gateway Provider (console for dev printing to server log, or pluggable gateway in prod)
OTP_PROVIDER=console

# Groq powers web chat text generation; Sarvam powers speech recognition and synthesis.
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# Optional: Gemini remains available for the legacy NLU/CLI tools.
NLU_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Optional local provider for legacy NLU/CLI tools.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
