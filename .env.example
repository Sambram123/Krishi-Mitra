# Krishi Mitra Environment Configuration

# Provider selection: "gemini" (recommended) or "ollama" (offline local fallback)
NLU_PROVIDER=gemini

# Google Gemini API Key (get from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Local Ollama configuration (optional, if NLU_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
